{
  "name": "operational-core-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@vizualmodel/vmblu-runtime": ">=1.10.0 <1.11.0"
  },
  "devDependencies": {
    "@vizualmodel/vmblu-cli": ">=1.10.0 <1.11.0"
  },
  "scripts": {
    "vm:init": "vmblu init .",
    "vm:profile": "vmblu profile operational-core-service.blu",
    "vm:app": "vmblu make-app operational-core-service.blu",
    "vm:capabilities": "vmblu make-capabilities operational-core-service.blu",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "node --check src/operational-core.js && node --check src/server.js",
    "test": "node --test"
  }
}
