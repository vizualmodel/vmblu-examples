  "root": {
    "kind": "group",
    "name": "Root",
    "prompt": "Solar-system-agent app composition.",
    "nodes": [
      {
        "kind": "source",
        "name": "SimulationClock",
        "prompt": "Maintains simulation time, time scale, and paused state, and emits simulation ticks.",
        "factory": {
          "path": "../nodes/simulation-clock.js",
          "function": "createSimulationClock"
        },
        "interfaces": [
          {
            "interface": "clock",
            "pins": [
              {
                "name": "clock.configure",
                "kind": "input",
                "contract": {
                  "role": "owner",
                  "payload": "ClockConfig"
                },
                "prompt": "Applies a new simulation start time and time scale configuration."
              },
              {
                "name": "clock.control",
                "kind": "input",
                "contract": {
                  "role": "owner",
                  "payload": "ClockControl"
                },
                "prompt": "Handles clock actions such as pause, resume, and speed changes."
              },
              {
                "name": "clock.state",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "SimulationState"
                },
                "prompt": "Emits the current simulation clock state for UI and agent context."
              },
              {
                "name": "clock.tick",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "SimulationTick"
                },
                "prompt": "Emits a tick whenever simulation time advances."
              }
            ]
          }
        ],
        "sx": {
          "tickMs": 50,
          "timeScale": 36000,
          "startIsoUtc": "",
          "stopIsoUtc": ""
        }
      },
      {
        "kind": "source",
        "name": "CommandRouter",
        "prompt": "Normalizes UI commands and routes them to the correct subsystem nodes.",
        "factory": {
          "path": "../nodes/command-router.js",
          "function": "createCommandRouter"
        },
        "interfaces": [
          {
            "interface": "ui",
            "pins": [
              {
                "name": "ui.command",
                "kind": "input",
                "contract": {
                  "role": "owner",
                  "payload": "CommandEnvelope"
                },
                "prompt": "Receives a normalized command from UI nodes for routing."
              },
              {
                "name": "ui.panel",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "UiPanelCommand"
                },
                "prompt": "Emits a command that changes UI panel visibility or state."
              }
            ]
          },
          {
            "interface": "render",
            "pins": [
              {
                "name": "render.view",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "RenderCommand"
                },
                "prompt": "Emits renderer or layout commands to the rendering group."
              },
              {
                "name": "render.camera",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "CameraCommand"
                },
                "prompt": "Emits camera placement or movement commands to the rendering group."
              }
            ]
          },
          {
            "interface": "chart",
            "pins": [
              {
                "name": "chart.command",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "ChartCommand"
                },
                "prompt": "Emits a chart request to the charts subsystem."
              }
            ]
          },
          {
            "interface": "solar",
            "pins": [
              {
                "name": "solar.command",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "CommandEnvelope"
                },
                "prompt": "Emits solar-system related commands to the solar system group."
              }
            ]
          },
          {
            "interface": "clock",
            "pins": [
              {
                "name": "clock.config",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "ClockConfig"
                },
                "prompt": "Emits a clock configuration message derived from a routed command."
              },
              {
                "name": "clock.control",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "ClockControl"
                },
                "prompt": "Emits messages on clock.control for CommandRouter."
              }
            ]
          }
        ]
      },
      {
        "kind": "group",
        "name": "Rendering",
        "prompt": "Composes layout, renderer, animator, and camera management for the 3D view.",
        "interfaces": [
          {
            "interface": "scene",
            "pins": [
              {
                "name": "scene.updates",
                "kind": "input",
                "contract": {
                  "role": "owner",
                  "payload": "ScenePatchList"
                },
                "prompt": "Receives scene patch updates that should be applied in this subsystem."
              },
              {
                "name": "scene.animatables",
                "kind": "input",
                "contract": {
                  "role": "owner",
                  "payload": "AnimatableBatch"
                },
                "prompt": "Receives animatable registrations for animation processing."
              },
              {
                "name": "scene.body-poses",
                "kind": "input",
                "contract": {
                  "role": "owner",
                  "payload": "BodyPoseList"
                },
                "prompt": "Receives current celestial body poses."
              }
            ]
          },
          {
            "interface": "render",
            "pins": [
              {
                "name": "render.command",
                "kind": "input",
                "contract": {
                  "role": "owner",
                  "payload": "CommandEnvelope"
                },
                "prompt": "Receives renderer or layout commands from the command router."
              }
            ]
          },
          {
            "interface": "camera",
            "pins": [
              {
                "name": "camera.command",
                "kind": "input",
                "contract": {
                  "role": "owner",
                  "payload": "CommandEnvelope"
                },
                "prompt": "Receives a camera placement or movement command."
              },
              {
                "name": "camera.active",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "CameraState"
                },
                "prompt": "Emits the currently active camera state."
              }
            ]
          },
          {
            "interface": "sim",
            "pins": [
              {
                "name": "sim.tick",
                "kind": "input",
                "contract": {
                  "role": "owner",
                  "payload": "SimulationTick"
                },
                "prompt": "Receives simulation ticks used to update local state."
              }
            ]
          },
          {
            "interface": "overlay",
            "pins": [
              {
                "name": "overlay.chart",
                "kind": "input",
                "contract": {
                  "role": "owner",
                  "payload": "ChartOverlay"
                },
                "prompt": "Receives the chart overlay payload that should be shown in the layout."
              }
            ]
          }
        ],
        "nodes": [
          {
            "kind": "source",
            "name": "ScreenLayout",
            "prompt": "Manages the full-screen canvas host and overlay panel placement.",
            "factory": {
              "path": "../nodes/rendering/screen-layout.js",
              "function": "createScreenLayout"
            },
            "interfaces": [
              {
                "interface": "layout",
                "pins": [
                  {
                    "name": "layout.command",
                    "kind": "input",
                    "contract": {
                      "role": "owner",
                      "payload": "RenderCommand"
                    },
                    "prompt": "Receives layout commands for canvas and overlay arrangement."
                  },
                  {
                    "name": "layout.chart-overlay",
                    "kind": "input",
                    "contract": {
                      "role": "owner",
                      "payload": "ChartOverlay"
                    },
                    "prompt": "Receives chart overlay data and visibility state."
                  },
                  {
                    "name": "layout.state",
                    "kind": "output",
                    "contract": {
                      "role": "owner",
                      "payload": "LayoutState"
                    },
                    "prompt": "Emits the resolved layout state used by renderer and camera manager."
                  }
                ]
              }
            ],
            "sx": {
              "ambientIntensity": 7,
              "sunIntensity": 1000,
              "showEcliptic": true,
              "showAxes": false
            }
          },
          {
            "kind": "source",
            "name": "Renderer",
            "prompt": "Hosts the THREE.js scene and render loop and applies scene and camera updates.",
            "factory": {
              "path": "../nodes/rendering/renderer.js",
              "function": "createRenderer"
            },
            "interfaces": [
              {
                "interface": "render",
                "pins": [
                  {
                    "name": "render.scene-patches",
                    "kind": "input",
                    "contract": {
                      "role": "owner",
                      "payload": "ScenePatchList"
                    },
                    "prompt": "Applies incoming scene patch batches to the renderer scene."
                  },
                  {
                    "name": "render.layout",
                    "kind": "input",
                    "contract": {
                      "role": "owner",
                      "payload": "LayoutState"
                    },
                    "prompt": "Receives layout state updates that affect canvas size or overlays."
                  },
                  {
                    "name": "render.camera",
                    "kind": "input",
                    "contract": {
                      "role": "owner",
                      "payload": "CameraState"
                    },
                    "prompt": "Receives the active camera state used by the render loop."
                  }
                ]
              }
            ]
          },
          {
            "kind": "source",
            "name": "Animator",
            "prompt": "Applies time-based updates to registered animatable objects using simulation ticks.",
            "factory": {
              "path": "../nodes/rendering/animator.js",
              "function": "createAnimator"
            },
            "interfaces": [
              {
                "interface": "anim",
                "pins": [
                  {
                    "name": "anim.scene-patches",
                    "kind": "output",
                    "contract": {
                      "role": "owner",
                      "payload": "ScenePatchList"
                    },
                    "prompt": "Emits scene patches generated by animation updates."
                  },
                  {
                    "name": "anim.tick",
                    "kind": "input",
                    "contract": {
                      "role": "owner",
                      "payload": "SimulationTick"
                    },
                    "prompt": "Receives simulation ticks that drive animation updates."
                  },
                  {
                    "name": "anim.registry",
                    "kind": "input",
                    "contract": {
                      "role": "owner",
                      "payload": "AnimatableBatch"
                    },
                    "prompt": "Receives the current set of animatable objects to manage."
                  },
                  {
                    "name": "anim.body-poses",
                    "kind": "input",
                    "contract": {
                      "role": "owner",
                      "payload": "BodyPoseList"
                    },
                    "prompt": "Receives body poses used to update animations tied to celestial bodies."
                  }
                ]
              }
            ]
          },
          {
            "kind": "source",
            "name": "CameraManager",
            "prompt": "Creates and updates cameras, including body-relative views and flyby motion.",
            "factory": {
              "path": "../nodes/rendering/camera-manager.js",
              "function": "createCameraManager"
            },
            "interfaces": [
              {
                "interface": "camera",
                "pins": [
                  {
                    "name": "camera.command",
                    "kind": "input",
                    "contract": {
                      "role": "owner",
                      "payload": "CameraCommand"
                    },
                    "prompt": "Receives a camera placement or movement command.",
                    "tool": {
                      "enabled": true,
                      "id": "camera.command @ CameraManager",
                      "title": "Camera Command",
                      "description": "Receives a camera placement or movement command.",
                      "risk": "low",
                      "approval": "never",
                      "schema": {},
                      "effects": []
                    }
                  },
                  {
                    "name": "ol/",
                    "kind": "output",
                    "contract": {
                      "role": "follower",
                      "payload": "any"
                    }
                  },
                  {
                    "name": "camera.body-poses",
                    "kind": "input",
                    "contract": {
                      "role": "owner",
                      "payload": "BodyPoseList"
                    },
                    "prompt": "Receives body poses used to resolve body-relative cameras."
                  },
                  {
                    "name": "camera.layout",
                    "kind": "input",
                    "contract": {
                      "role": "owner",
                      "payload": "LayoutState"
                    },
                    "prompt": "Receives layout updates that can affect camera aspect or controls."
                  },
                  {
                    "name": "camera.active",
                    "kind": "output",
                    "contract": {
                      "role": "owner",
                      "payload": "CameraState"
                    },
                    "prompt": "Emits the currently active camera state."
                  },
                  {
                    "name": "camera.event",
                    "kind": "output",
                    "contract": {
                      "role": "owner",
                      "payload": "CameraEvent"
                    },
                    "prompt": "Emits semantic camera changes for agent observation.",
                    "event": {
                      "enabled": true,
                      "id": "camera.event @ CameraManager",
                      "title": "Camera Event",
                      "description": "Emits semantic camera changes for agent observation.",
                      "schema": {}
                    }
                  }
                ]
              }
            ],
            "sx": {
              "sunRadiusMultiplier": 10,
              "planetRadiusMultiplier": 200,
              "activeCameraId": "earth-camera",
              "defaultCameraState": {
                "positionAu": {
                  "x": 1,
                  "y": 0,
                  "z": 0.2
                },
                "targetAu": {
                  "x": 0,
                  "y": 0,
                  "z": 0
                }
              },
              "startupCameras": [
                {
                  "cameraId": "earth-camera",
                  "label": "Earth Camera",
                  "mode": "body-follow",
                  "followBodyId": "earth",
                  "targetBodyId": "earth",
                  "dx": 0.03,
                  "dy": 0,
                  "dz": 0.01
                },
                {
                  "cameraId": "jupiter-camera",
                  "label": "Jupiter Camera",
                  "mode": "body-follow",
                  "followBodyId": "jupiter",
                  "targetBodyId": "jupiter",
                  "dx": 0.45,
                  "dy": 0,
                  "dz": 0.08
                }
              ]
            }
          }
        ],
        "connections": [
          {
            "src": {
              "pin": "layout.state",
              "node": "ScreenLayout"
            },
            "dst": [
              {
                "pin": "camera.layout",
                "node": "CameraManager"
              },
