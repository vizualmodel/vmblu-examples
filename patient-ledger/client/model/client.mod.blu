  "types": {
    "AnyPayload": {
      "kind": "primitive",
      "summary": "Opaque payload used while the clinical client architecture is still being refined."
    },
    "PageFragment": {
      "kind": "object",
      "summary": "A browser UI fragment contributed by a node that wants page real estate.",
      "fields": {
        "fragmentId": {
          "vmbluType": "string"
        },
        "region": {
          "vmbluType": "string"
        },
        "priority": {
          "vmbluType": "number"
        },
        "div": {
          "vmbluType": "AnyPayload"
        }
      },
      "required": [
        "fragmentId",
        "region",
        "div"
      ]
    },
    "PageDocument": {
      "kind": "object",
      "summary": "The assembled browser page produced by PageLayout.",
      "fields": {
        "layoutId": {
          "vmbluType": "string"
        },
        "regions": {
          "vmbluType": "AnyPayload"
        }
      },
      "required": [
        "layoutId",
        "regions"
      ]
    },
    "AuthRequest": {
      "kind": "object",
      "summary": "Login, logout or session refresh request from the clinical client.",
      "fields": {
        "requestId": {
          "vmbluType": "string"
        },
        "operation": {
          "vmbluType": "string"
        },
        "actorId": {
          "vmbluType": "string"
        },
        "credential": {
          "vmbluType": "string"
        },
        "sessionKey": {
          "vmbluType": "string"
        },
        "requestedAt": {
          "vmbluType": "string"
        }
      },
      "required": [
        "requestId",
        "operation",
        "requestedAt"
      ]
    },
    "AuthState": {
      "kind": "object",
      "summary": "Current authenticated session state returned by the server authority.",
      "fields": {
        "requestId": {
          "vmbluType": "string"
        },
        "outcome": {
          "vmbluType": "string"
        },
        "actorId": {
          "vmbluType": "string"
        },
        "role": {
          "vmbluType": "string"
        },
        "sessionKey": {
          "vmbluType": "string"
        },
        "reason": {
          "vmbluType": "string"
        }
      },
      "required": [
        "requestId",
        "outcome"
      ]
    },
    "PatientRequest": {
      "kind": "object",
      "summary": "Patient search, selection or visible-record request.",
      "fields": {
        "requestId": {
          "vmbluType": "string"
        },
        "sessionKey": {
          "vmbluType": "string"
        },
        "operation": {
          "vmbluType": "string"
        },
        "patientId": {
          "vmbluType": "string"
        },
        "searchText": {
          "vmbluType": "string"
        },
        "requestedAt": {
          "vmbluType": "string"
        }
      },
      "required": [
        "requestId",
        "operation",
        "requestedAt"
      ]
    },
    "PatientDataView": {
      "kind": "object",
      "summary": "Policy-filtered patient data that the clinical client may display.",
      "fields": {
        "requestId": {
          "vmbluType": "string"
        },
        "outcome": {
          "vmbluType": "string"
        },
        "patientId": {
          "vmbluType": "string"
        },
        "data": {
          "vmbluType": "AnyPayload"
        },
        "reason": {
          "vmbluType": "string"
        },
        "decisionId": {
          "vmbluType": "string"
        }
      },
      "required": [
        "requestId",
        "outcome"
      ]
    }
  },
