{
  "name": "vmblu-examples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "solar-system",
    "chat-application/chat-client",
    "chat-application/chat-server",
    "crisis-grid/command-centre-web",
    "crisis-grid/operational-core-service"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "gallery:validate": "node scripts/validate-gallery.mjs && node scripts/validate-systems.mjs",
    "pages:stage": "node scripts/stage-pages.mjs",
    "pages:build": "npm run build --workspace solar-system && npm run gallery:validate && npm run pages:stage",
    "vm:profile": "npm run vm:profile --workspaces --if-present",
    "vm:app": "npm run vm:app --workspaces --if-present",
    "vm:capabilities": "npm run vm:capabilities --workspaces --if-present"
  },
  "devDependencies": {
    "@vizualmodel/vmblu-cli": ">=1.11.0 <1.12.0",
    "ajv": "^8.18.0"
  }
}
