{
  "name": "chat-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@vizualmodel/vmblu-runtime": "^0.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vizualmodel/vmblu-cli": "^0.5.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "vm:init": "vmblu init .",
    "vm:profile": "vmblu profile chat-server.blu",
    "vm:app": "vmblu make-app chat-server.blu",
    "vm:capabilities": "vmblu make-capabilities chat-server.blu",
    "start": "node model/chat-server.app.js",
