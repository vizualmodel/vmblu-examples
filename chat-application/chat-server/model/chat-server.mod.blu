{
  "header": {
    "version": "0.9.3",
    "created": "2026-02-11T11:09:28.414Z",
    "saved": "2026-02-11T11:25:00.000Z",
    "utc": "2026-02-11T11:25:00.000Z",
    "runtime": "@vizualmodel/vmblu-runtime/rt-base"
  },
  "factories": [
    {
      "path": "../nodes/ws-gateway.js",
      "function": "createWsGatewayNode"
    },
    {
      "path": "../nodes/chat-state.js",
      "function": "createChatStateNode"
    }
  ],
  "types": {
    "LoginRequest": {
      "kind": "object",
      "summary": "Login data received from a client connection.",
      "fields": {
        "connectionId": {
          "vmbluType": "string"
        },
        "userName": {
          "vmbluType": "string"
        }
      },
      "required": [
        "connectionId",
        "userName"
      ]
    },
    "LoginAccepted": {
      "kind": "object",
      "summary": "Assigned user identity for a connected client.",
      "fields": {
        "connectionId": {
          "vmbluType": "string"
        },
        "userId": {
          "vmbluType": "string"
        },
        "userName": {
          "vmbluType": "string"
        }
      },
      "required": [
        "connectionId",
        "userId",
        "userName"
      ]
    },
    "ChatMessageInput": {
      "kind": "object",
      "summary": "Incoming chat payload from a connected client.",
      "fields": {
        "userId": {
          "vmbluType": "string"
        },
        "text": {
          "vmbluType": "string"
        }
      },
      "required": [
        "userId",
        "text"
      ]
    },
    "ChatMessage": {
      "kind": "object",
      "summary": "Canonical chat message stored by the server.",
      "fields": {
        "id": {
          "vmbluType": "string"
        },
        "userId": {
          "vmbluType": "string"
        },
        "userName": {
          "vmbluType": "string"
        },
        "text": {
          "vmbluType": "string"
        },
        "sentAt": {
          "vmbluType": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "userName",
        "text",
        "sentAt"
      ]
    },
    "ChatMessageList": {
      "kind": "array",
      "summary": "Ordered list of chat messages.",
      "items": {
        "vmbluType": "ChatMessage"
      }
    },
    "HistoryDelivery": {
      "kind": "object",
      "summary": "History payload targeted to one client connection.",
      "fields": {
        "connectionId": {
          "vmbluType": "string"
        },
        "messages": {
          "vmbluType": "ChatMessageList"
        }
      },
      "required": [
        "connectionId",
        "messages"
      ]
    }
  },
  "root": {
    "kind": "group",
    "name": "Root",
    "prompt": "Server-side chat backend composition.",
    "nodes": [
      {
        "kind": "source",
        "name": "ws gateway",
        "prompt": "Hosts websocket endpoints and maps socket events to vmblu messages.",
        "factory": {
          "path": "../nodes/ws-gateway.js",
          "function": "createWsGatewayNode"
        },
        "interfaces": [
          {
            "interface": "auth",
            "pins": [
              {
                "name": "auth.login-received",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "LoginRequest"
                },
                "prompt": "Emits when a client requests login."
              },
              {
                "name": "auth.login-result",
                "kind": "input",
                "contract": {
                  "role": "follower",
                  "payload": "LoginAccepted"
                },
                "prompt": "Applies successful login result for a pending connection."
              }
            ]
          },
          {
            "interface": "chat",
            "pins": [
              {
                "name": "chat.message-received",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "ChatMessageInput"
                },
                "prompt": "Emits when a connected client sends a chat message."
              },
              {
                "name": "chat.history-deliver",
                "kind": "input",
                "contract": {
                  "role": "follower",
                  "payload": "HistoryDelivery"
                },
                "prompt": "Sends message history to one target connection."
              },
              {
                "name": "chat.message-deliver",
                "kind": "input",
                "contract": {
                  "role": "follower",
                  "payload": "ChatMessage"
                },
                "prompt": "Broadcasts a stored chat message to connected clients."
              }
            ]
          },
          {
            "interface": "session",
            "pins": [
              {
                "name": "session.user-disconnected",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "string"
                },
                "prompt": "Emits when an authenticated user disconnects."
              }
            ]
          }
        ]
      },
      {
        "kind": "source",
        "name": "chat state",
        "prompt": "Maintains logged-in users and message history, and prepares outbound server events.",
        "factory": {
          "path": "../nodes/chat-state.js",
          "function": "createChatStateNode"
        },
        "interfaces": [
          {
            "interface": "auth",
            "pins": [
              {
                "name": "auth.login-received",
                "kind": "input",
                "contract": {
                  "role": "follower",
                  "payload": "LoginRequest"
                },
                "prompt": "Registers a user login and allocates server identity."
              },
              {
                "name": "auth.login-result",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "LoginAccepted"
                },
                "prompt": "Returns assigned user identity for the login connection."
              }
            ]
          },
          {
            "interface": "chat",
            "pins": [
              {
                "name": "chat.message-received",
                "kind": "input",
                "contract": {
                  "role": "follower",
                  "payload": "ChatMessageInput"
                },
                "prompt": "Stores an incoming client message into chat history."
              },
              {
                "name": "chat.history-deliver",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "HistoryDelivery"
                },
                "prompt": "Emits full history to the newly logged-in connection."
              },
              {
                "name": "chat.message-deliver",
                "kind": "output",
                "contract": {
                  "role": "owner",
                  "payload": "ChatMessage"
                },
                "prompt": "Emits canonical chat messages for broadcast to all clients."
              }
            ]
          },
          {
            "interface": "session",
            "pins": [
              {
                "name": "session.user-disconnected",
                "kind": "input",
                "contract": {
                  "role": "follower",
                  "payload": "string"
                },
                "prompt": "Removes disconnected users from active session tracking."
              }
            ]
          }
        ]
      }
    ],
    "connections": [
      {
        "src": {
          "pin": "auth.login-received",
          "node": "ws gateway"
        },
        "dst": {
          "pin": "auth.login-received",
          "node": "chat state"
        }
      },
      {
        "src": {
          "pin": "chat.message-received",
          "node": "ws gateway"
        },
        "dst": {
          "pin": "chat.message-received",
          "node": "chat state"
        }
      },
      {
        "src": {
          "pin": "session.user-disconnected",
          "node": "ws gateway"
        },
        "dst": {
          "pin": "session.user-disconnected",
          "node": "chat state"
        }
      },
      {
        "src": {
          "pin": "auth.login-result",
          "node": "chat state"
        },
        "dst": {
          "pin": "auth.login-result",
          "node": "ws gateway"
        }
      },
      {
        "src": {
          "pin": "chat.history-deliver",
          "node": "chat state"
        },
        "dst": {
          "pin": "chat.history-deliver",
          "node": "ws gateway"
        }
      },
      {
        "src": {
          "pin": "chat.message-deliver",
          "node": "chat state"
        },
        "dst": {
          "pin": "chat.message-deliver",
          "node": "ws gateway"
        }
      }
    ]
  }
}
