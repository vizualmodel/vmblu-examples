    "runtime": "@vizualmodel/vmblu-runtime/rt-base"
  },
  "factories": [
    "../nodes/ws-gateway.js",
    "../nodes/chat-state.js"
  ],
  "types": {
    "LoginRequest": {
      "kind": "object",
      "summary": "Login data received from a client connection.",
      "fields": {
        "connectionId": {
          "vmbluType": "string"
        },
        "userName": {
          "vmbluType": "string"
        }
      },
      "required": [
        "connectionId",
        "userName"
      ]
    },
    "LoginAccepted": {
      "kind": "object",
      "summary": "Assigned user identity for a connected client.",
      "fields": {
        "connectionId": {
          "vmbluType": "string"
        },
        "userId": {
          "vmbluType": "string"
        },
        "userName": {
          "vmbluType": "string"
        }
      },
      "required": [
        "connectionId",
        "userId",
        "userName"
      ]
    },
    "ChatMessageInput": {
      "kind": "object",
      "summary": "Incoming chat payload from a connected client.",
      "fields": {
        "userId": {
          "vmbluType": "string"
        },
        "text": {
          "vmbluType": "string"
        }
      },
      "required": [
        "userId",
        "text"
      ]
    },
    "ChatMessage": {
      "kind": "object",
      "summary": "Canonical chat message stored by the server.",
      "fields": {
        "id": {
          "vmbluType": "string"
        },
        "userId": {
          "vmbluType": "string"
        },
        "userName": {
          "vmbluType": "string"
        },
        "text": {
          "vmbluType": "string"
        },
        "sentAt": {
          "vmbluType": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "userName",
        "text",
        "sentAt"
      ]
    },
    "ChatMessageList": {
      "kind": "array",
      "summary": "Ordered list of chat messages.",
      "items": {
        "vmbluType": "ChatMessage"
      }
    },
    "HistoryDelivery": {
      "kind": "object",
      "summary": "History payload targeted to one client connection.",
      "fields": {
        "connectionId": {
          "vmbluType": "string"
        },
        "messages": {
          "vmbluType": "ChatMessageList"
        }
      },
      "required": [
        "connectionId",
        "messages"
      ]
    }
  },
