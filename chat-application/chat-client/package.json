{
  "name": "chat-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@vizualmodel/vmblu-runtime": ">=1.12.0 <1.13.0",
    "svelte": "^5.38.10"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@vizualmodel/vmblu-cli": ">=1.12.0 <1.13.0",
