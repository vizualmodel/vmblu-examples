        },
        "dst": {
          "pin": "chat.outgoing-message",
          "node": "ws transport"
        }
      },
      {
        "src": {
          "pin": "net.connection-state",
          "node": "client controller"
        },
        "dst": {
          "pin": "chat.connection-state",
          "node": "message history"
        }
      },
      {
        "src": {
          "pin": "net.connection-state",
          "node": "client controller"
        },
        "dst": {
          "pin": "chat.connection-state",
          "node": "message composer"
        }
      },
      {
        "src": {
          "pin": "history.message-list",
          "node": "client controller"
        },
        "dst": {
          "pin": "chat.message-list",
          "node": "message history"
        }
      },
      {
        "src": {
          "pin": "history.append-message",
          "node": "client controller"
        },
        "dst": {
          "pin": "chat.append-message",
          "node": "message history"
        }
      },
      {
        "src": {
          "pin": "history.current-user",
          "node": "client controller"
        },
        "dst": {
          "pin": "chat.current-user",
          "node": "message history"
        }
      },
      {
        "src": {
          "pin": "ui.get-history-view",
          "node": "client controller"
        },
        "dst": {
          "pin": "ui.get-view",
          "node": "message history"
        }
      },
      {
        "src": {
