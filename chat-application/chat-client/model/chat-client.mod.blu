    "runtime": "@vizualmodel/vmblu-runtime/rt-browser-agent",
    "teams": {
      "default": {
        "color": "#0066ff"
      }
    },
    "agent": {
      "schema": "https://vmblu.dev/schemas/agents.v1.json",
      "version": 1,
      "defaultInterface": "chat-assistant",
      "profiles": [
        {
          "id": "chat-operator",
          "title": "Chat operator",
          "enabled": true,
          "permissions": {
            "tools": {
              "allow": [
                "chat.send-message"
              ],
              "deny": []
            },
            "probes": {
              "allow": [
                "chat.history"
              ],
              "deny": []
            },
            "events": {
              "allow": [
                "chat.message-received"
              ],
              "deny": []
            }
          },
          "limits": {
            "maxToolCallsPerTurn": 4
          }
        }
      ],
      "interfaces": [
        {
          "id": "chat-assistant",
          "title": "Chat assistant",
          "enabled": true,
          "kind": "embedded",
          "profile": "chat-operator",
          "instructions": "Help the logged-in user participate in the conversation. Read chat.history when context is needed. Use chat.send-message only when the user explicitly asks you to send or reply. Treat chat.message-received as confirmation that the server broadcast a message.",
          "llm": {
            "provider": "openai",
            "model": "gpt-4.1-mini",
            "endpoint": "http://127.0.0.1:8787/v1"
          },
          "ui": {
            "mode": "overlay"
          }
        }
      ]
    }
  },
  "factories": [
    "../nodes/message history/index.js",
    "../nodes/message composer/index.js",
    "../nodes/client-controller.js",
    "../nodes/ws-transport.js",
    "../nodes/login popup/index.js"
  ],
  "types": {
    "UserName": {
      "kind": "object",
      "summary": "The entered user name.",
      "fields": {
        "name": {
          "vmbluType": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "LoginEvent": {
      "kind": "object",
      "summary": "Successful login/session information from the server.",
      "fields": {
        "userId": {
          "vmbluType": "string"
        },
        "userName": {
          "vmbluType": "string"
        }
      },
      "required": [
        "userId",
        "userName"
      ]
    },
    "ChatMessage": {
      "kind": "object",
      "summary": "One chat message shown in the client.",
      "fields": {
        "id": {
          "vmbluType": "string"
        },
        "userId": {
          "vmbluType": "string"
        },
        "userName": {
          "vmbluType": "string"
        },
        "text": {
          "vmbluType": "string"
        },
        "sentAt": {
          "vmbluType": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "userName",
        "text",
        "sentAt"
      ]
    },
    "ChatMessageList": {
      "kind": "array",
      "summary": "Ordered list of chat messages.",
      "items": {
        "vmbluType": "ChatMessage"
      }
    },
    "ChatHistory": {
      "kind": "object",
      "summary": "Message history delivered at login time.",
      "fields": {
        "messages": {
          "vmbluType": "ChatMessageList"
        }
      },
      "required": [
        "messages"
      ]
    },
    "OutgoingChatMessage": {
      "kind": "object",
      "summary": "User message emitted by the client.",
      "fields": {
        "userId": {
          "vmbluType": "string"
        },
        "text": {
          "vmbluType": "string"
        }
      },
      "required": [
        "userId",
        "text"
      ]
    },
    "AgentSendMessage": {
      "kind": "object",
      "summary": "A chat message requested by the operating agent.",
      "fields": {
        "text": {
          "vmbluType": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "AgentSendResult": {
      "kind": "object",
      "summary": "Whether an agent-requested message was accepted by the client.",
      "fields": {
        "accepted": {
          "vmbluType": "boolean"
        },
        "status": {
          "vmbluType": "string"
        },
        "text": {
          "vmbluType": "string"
        }
      },
      "required": [
        "accepted",
        "status",
        "text"
      ]
    },
    "UiView": {
      "kind": "object",
      "summary": "A UI view element exposed by a node.",
      "fields": {
        "slot": {
          "vmbluType": "string"
        },
        "element": {
          "vmbluType": "any"
        }
      },
      "required": [
        "slot",
        "element"
      ]
    }
  },
