  "types": {
    "UserName": {
      "kind": "object",
      "summary": "The entered user name.",
      "fields": {
        "name": {
          "vmbluType": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "LoginEvent": {
      "kind": "object",
      "summary": "Successful login/session information from the server.",
      "fields": {
        "userId": {
          "vmbluType": "string"
        },
        "userName": {
          "vmbluType": "string"
        }
      },
      "required": [
        "userId",
        "userName"
      ]
    },
    "ChatMessage": {
      "kind": "object",
      "summary": "One chat message shown in the client.",
      "fields": {
        "id": {
          "vmbluType": "string"
        },
        "userId": {
          "vmbluType": "string"
        },
        "userName": {
          "vmbluType": "string"
        },
        "text": {
          "vmbluType": "string"
        },
        "sentAt": {
          "vmbluType": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "userName",
        "text",
        "sentAt"
      ]
    },
    "ChatMessageList": {
      "kind": "array",
      "summary": "Ordered list of chat messages.",
      "items": {
        "vmbluType": "ChatMessage"
      }
    },
    "ChatHistory": {
      "kind": "object",
      "summary": "Message history delivered at login time.",
      "fields": {
        "messages": {
          "vmbluType": "ChatMessageList"
        }
      },
      "required": [
        "messages"
      ]
    },
    "OutgoingChatMessage": {
      "kind": "object",
      "summary": "User message emitted by the client.",
      "fields": {
        "userId": {
          "vmbluType": "string"
        },
        "text": {
          "vmbluType": "string"
        }
      },
      "required": [
        "userId",
        "text"
      ]
    },
    "UiView": {
      "kind": "object",
      "summary": "A UI view element exposed by a node.",
      "fields": {
        "slot": {
          "vmbluType": "string"
        },
        "element": {
          "vmbluType": "any"
        }
      },
      "required": [
        "slot",
        "element"
      ]
    }
  },
